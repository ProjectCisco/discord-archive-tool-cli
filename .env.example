# Copy to .env and fill in. Never commit .env.

# --- Always needed ---
DISCORD_TOKEN=            # Developer Portal → your app → Bot → Reset Token. Keep secret.
DISCORD_LOG_CHANNEL_ID=   # Right-click the log channel → Copy Channel ID
ARCHIVER_DATA_DIR=        # Working folder, outside this repo, e.g. C:\Users\you\discord-archive-data

# --- Only for --to onedrive ---
GRAPH_TENANT_ID=          # Entra → your app → Overview → Directory (tenant) ID
GRAPH_CLIENT_ID=          # Entra → your app → Overview → Application (client) ID
ONEDRIVE_ROOT=            # Existing OneDrive folder, e.g. Team/Archives

# --- Only for --to google-drive ---
GOOGLE_CLIENT_ID=         # Google Cloud client, type "TVs and Limited Input devices"
GOOGLE_CLIENT_SECRET=     # From the same client. Keep out of the repo.
GOOGLE_DRIVE_ROOT=        # Folder name the tool creates in My Drive, e.g. Discord Archives
