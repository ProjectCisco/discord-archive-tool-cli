# Copy this file to .env and fill it in. Never commit .env.

# --- Always needed ---

# Bot token for your own Discord application. Secret.
DISCORD_TOKEN=

# Channel where archive and delete results are posted.
DISCORD_LOG_CHANNEL_ID=

# Folder for working copies, run state and the audit log.
# Keep it outside this repository, on storage only you can read.
ARCHIVER_DATA_DIR=

# --- Only for --to onedrive ---

# Microsoft Entra tenant ID and app registration (client) ID. Both are GUIDs.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# Folder path inside the signed-in account's OneDrive, e.g. Team/Archives. Must already exist.
ONEDRIVE_ROOT=

# --- Only for --to google-drive ---

# OAuth client of type "TVs and Limited Input devices" from your Google Cloud project.
# Google calls the second value a secret, but for this client type it can't be kept secret;
# still, keep it out of the repository.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Name of the top folder the tool creates in your My Drive on its first run, e.g. Discord Archives.
# You can move or share it afterwards.
GOOGLE_DRIVE_ROOT=
